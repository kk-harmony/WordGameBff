# Fly bootstrap secrets only (copy to .env.fly — never commit).
# Non-secrets (GameApi URL, CORS, CustomAuth Authority/Audience, BackplaneType, Stores__Type=Redis) live in fly.toml [env].

# CustomAuth M2M (required)
CUSTOMAUTH__CLIENTID=
CUSTOMAUTH__CLIENTSECRET=

# BFF session JWT HMAC (>= 32 chars). Leave empty to auto-generate in setup-fly.sh.
SESSION__SIGNINGKEY=

# Redis for SignalR backplane + shared BFF stores (Equinoctial.Redis connection string).
# Provision: fly redis create  (Upstash) or any Redis reachable from the Fly app.
REALTIME__BACKPLANE__CONNECTIONSTRING=host=YOUR_REDIS_HOST;port=6379;username=default;password=YOUR_PASSWORD
