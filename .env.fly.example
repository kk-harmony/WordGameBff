# Fly bootstrap secrets only (copy to .env.fly — never commit).
# Non-secrets (GameApi URL, CORS, CustomAuth Authority/Audience, BackplaneType) live in fly.toml [env].

# CustomAuth M2M (required)
CUSTOMAUTH__CLIENTID=
CUSTOMAUTH__CLIENTSECRET=

# BFF session JWT HMAC (>= 32 chars). Leave empty to auto-generate in setup-fly.sh.
SESSION__SIGNINGKEY=

# Postgres for shared BFF stores (Npgsql — NOT Fly's DATABASE_URL URI).
STORES__CONNECTIONSTRING=Host=YOUR_HOST;Port=5432;Database=YOUR_DB;Username=YOUR_USER;Password=YOUR_PASSWORD;SSL Mode=Require

# Or set parts instead of STORES__CONNECTIONSTRING (script builds Npgsql with SSL Mode=Require):
# FLY_PG_HOST=
# FLY_PG_PORT=5432
# FLY_PG_DB=
# FLY_PG_USER=
# FLY_PG_PASSWORD=

# Redis for SignalR backplane (Equinoctial.Redis connection string).
# Provision: fly redis create  (Upstash) or any Redis reachable from the Fly app.
REALTIME__BACKPLANE__CONNECTIONSTRING=host=YOUR_REDIS_HOST;port=6379;password=YOUR_PASSWORD
