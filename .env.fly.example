# Fly bootstrap secrets only (copy to .env.fly — never commit).
# Non-secrets (GameApi URL, CORS, CustomAuth Authority/Audience) live in fly.toml [env].

# CustomAuth M2M (required)
CUSTOMAUTH__CLIENTID=
CUSTOMAUTH__CLIENTSECRET=

# BFF session JWT HMAC (>= 32 chars). Leave empty to auto-generate in setup-fly.sh.
SESSION__SIGNINGKEY=

# Postgres for SignalR backplane + BFF stores (Npgsql — NOT Fly's DATABASE_URL URI).
# Prefer the full string from the Fly Postgres dashboard / fly postgres db list.
REALTIME__BACKPLANE__CONNECTIONSTRING=Host=YOUR_HOST;Port=5432;Database=YOUR_DB;Username=YOUR_USER;Password=YOUR_PASSWORD;SSL Mode=Require

# Or set parts instead of REALTIME__BACKPLANE__CONNECTIONSTRING (script builds Npgsql with SSL Mode=Require):
# FLY_PG_HOST=
# FLY_PG_PORT=5432
# FLY_PG_DB=
# FLY_PG_USER=
# FLY_PG_PASSWORD=
