# Game API (internal only — not exposed on host)
GAMEAPI__BASEURL=http://wordgames:8081

# CustomAuth M2M credentials — BFF service token only (https://customauth.fly.dev/)
CUSTOMAUTH__AUTHORITY=https://customauth.fly.dev/
CUSTOMAUTH__CLIENTID=
CUSTOMAUTH__CLIENTSECRET=
# Legacy option; upstream identity is delegated via X-Delegated-User-Id
CUSTOMAUTH__AUDIENCE=wordgame

# BFF session JWT
SESSION__SIGNINGKEY=change-me-to-a-long-random-string-at-least-32-chars
SESSION__EXPIRYMINUTES=60
SESSION__ISSUER=wordgamebff

# Proof of Work
POW__DIFFICULTYBITS=20
POW__CHALLENGEEXPIRYSECONDS=300

# CORS — demo page origin for Podman local stack
CORS__ALLOWEDORIGINS__0=http://localhost:3100
CORS__ALLOWEDORIGINS__1=http://localhost:5174

# Realtime (Podman local: Redis backplane + host Postgres stores)
REALTIME__TRANSPORT=SignalR
REALTIME__BACKPLANETYPE=Redis

# Shared BFF state (Postgres KV — separate from Redis backplane)
STORES__TYPE=PostgreSQL

# wordgames repo path (for Podman/Docker image build)
WORDGAMES_BUILD_CONTEXT=../../learningProjects/wordgames

# Host PostgreSQL (locally installed — not in Podman)
POSTGRES_HOST=host.containers.internal
POSTGRES_PORT=5432
POSTGRES_USER=mainuser
POSTGRES_PASSWORD=change-me

# Host Redis for SignalR backplane (optional).
# run-podman-local.sh: if localhost:${REDIS_PORT} responds to PING, reuse it;
# otherwise Podman starts a 2-node Redis Cluster (redis-1/redis-2) on the compose network.
REDIS_HOST=host.containers.internal
REDIS_PORT=6379
# Host-published ports when the managed cluster is deployed (BFF uses internal DNS).
REDIS_CLUSTER_PORT_1=6479
REDIS_CLUSTER_PORT_2=6480

# Equinoctial connection string — script overwrites at runtime when deploying managed cluster.
# Standalone: host=host.containers.internal;port=6379
# Cluster:    cluster://redis-1:6379,redis-2:6379
REALTIME__BACKPLANE__CONNECTIONSTRING=host=host.containers.internal;port=6379

# Shared password used by wordgames + wordgamebff (must match POSTGRES_PASSWORD)
QUARKUS_DATASOURCE_PASSWORD=change-me

# wordgames OIDC — introspect opaque BFF service tokens (same M2M client as wordgamebff)
OIDC_AUTH_SERVER_URL=https://customauth.fly.dev/
OIDC_TOKEN_AUDIENCE=resource_server

# Host ports (Podman local — offset from common defaults to avoid clashes)
WORDGAMEBFF_HTTP_PORT=8180
DEMO_HTTP_PORT=3100
