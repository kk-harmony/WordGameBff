{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "GameApi": {
    "BaseUrl": "http://wordgames:8081",
    "WarmupPath": "/q/health/live"
  },
  "CustomAuth": {
    "Authority": "https://customauth.fly.dev/",
    "ClientId": "",
    "ClientSecret": "",
    "Audience": "wordgame"
  },
  "Session": {
    "SigningKey": "dev-only-change-me-to-a-long-random-string",
    "ExpiryMinutes": 60,
    "Issuer": "wordgamebff"
  },
  "Pow": {
    "DifficultyBits": 16,
    "ChallengeExpirySeconds": 300
  },
  "Cors": {
    "AllowedOrigins": [
      "http://localhost:3100",
      "http://localhost:5174"
    ]
  },
  "Realtime": {
    "Transport": "SignalR",
    "BackplaneType": "Redis",
    "MaxConnectionsPerUser": 3,
    "HubJoinUpstreamTimeoutSeconds": 3,
    "Backplane": {
      "ConnectionString": "host=redis;port=6379",
      "ChannelName": "wordgamebff_backplane"
    }
  },
  "GameSnapshot": {
    "PushEnabled": true,
    "CacheTtlSeconds": 120,
    "MaxPayloadBytes": 6000
  },
  "RateLimiting": {
    "AuthIpPermitLimit": 120,
    "ApiIpPermitLimit": 300,
    "ApiSessionPermitLimit": 180,
    "HubIpPermitLimit": 180
  },
  "Stores": {
    "Type": "InMemory"
  }
}
