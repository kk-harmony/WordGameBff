{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "GameApi": {
    "BaseUrl": "http://wordgames:8081",
    "WarmupPath": "/q/health/live"
  },
  "CustomAuth": {
    "Authority": "https://customauth.fly.dev/",
    "ClientId": "",
    "ClientSecret": "",
    "Audience": "wordgame"
  },
  "Session": {
    "SigningKey": "dev-only-change-me-to-a-long-random-string",
    "ExpiryMinutes": 60,
    "Issuer": "wordgamebff"
  },
  "Pow": {
    "DifficultyBits": 20,
    "ChallengeExpirySeconds": 300
  },
  "Cors": {
    "AllowedOrigins": [
      "http://localhost:3000",
      "http://localhost:5173"
    ]
  },
  "Realtime": {
    "Transport": "SignalR",
    "BackplaneType": "PostgreSQL",
    "MaxConnectionsPerUser": 3,
    "HubJoinUpstreamTimeoutSeconds": 3,
    "Backplane": {
      "ConnectionString": "Host=db;Port=5432;Database=wordgamebff;Username=mainuser;Password=change-me"
    }
  },
  "GameSnapshot": {
    "PushEnabled": true,
    "CacheTtlSeconds": 120,
    "MaxPayloadBytes": 6000
  },
  "Stores": {
    "Type": "InMemory"
  }
}
